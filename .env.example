# ==========================================
# Tutrago Environment Variables
# ==========================================

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://tutrago_user:tutrago_secret_password@localhost:5432/tutrago_db?schema=public"

# Redis (Redis 7)
REDIS_URL="redis://localhost:6379"

# API Server
PORT=3001
API_URL="http://localhost:3001"
JWT_SECRET="tutrago_super_secret_jwt_key_2026_dev_env"
JWT_OFFLINE_SECRET="tutrago_offline_ticket_secret_key_8841"

# Mercado Pago Marketplace (Split Payment)
MP_CLIENT_ID="your_mp_client_id"
MP_CLIENT_SECRET="your_mp_client_secret"
MP_PLATFORM_ACCESS_TOKEN="TEST-your-collector-access-token"
MP_WEBHOOK_SECRET="your_mp_webhook_secret_hmac"

# Incubatio Platform Fee (Percentage)
INCUBATIO_COMMISSION_PCT=10.0

# Frontend KDS
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Client App / Expo
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_WS_URL="ws://localhost:3001"

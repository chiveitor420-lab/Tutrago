# ==========================================
# Tutrago Environment Variables
# ==========================================

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://tutrago_user:tutrago_secret_password@localhost:5432/tutrago_db?schema=public"

# Redis (Redis 7)
REDIS_URL="redis://localhost:6379"

# API Server
PORT=3001
API_URL="http://localhost:3001"
JWT_SECRET="replace_with_64_char_hex_crypto_random_bytes"
TICKET_HMAC_SECRET="replace_with_64_char_hex_crypto_random_bytes"
PILOT_SANDBOX_PIN="replace_with_32_char_hex_pilot_pin"

# Mercado Pago Marketplace (Split Payment)
MP_CLIENT_ID="your_mp_client_id"
MP_CLIENT_SECRET="your_mp_client_secret"
MP_PLATFORM_ACCESS_TOKEN="TEST-your-collector-access-token"
MP_WEBHOOK_SECRET="your_mp_webhook_secret_hmac"

# Incubatio Platform Fee & Gateway Costs (Percentage)
INCUBATIO_COMMISSION_PCT=10.0
MP_GATEWAY_FEE_PCT=4.5
MP_SANDBOX_MODE="true"
PILOT_SIMULATOR_PIN="2026"

# Frontend KDS
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Client App / Expo
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_WS_URL="ws://localhost:3001"

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "cd ../.. && npx expo export -p web",
  "installCommand": "cd ../.. && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

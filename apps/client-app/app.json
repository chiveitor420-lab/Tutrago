{
  "expo": {
    "name": "Tutrago",
    "slug": "tutrago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tutrago",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "splash": {
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}

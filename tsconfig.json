{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@tutrago/shared-types": ["packages/shared-types/src/index.ts"],
      "@tutrago/ui-kit": ["packages/ui-kit/src/index.ts"],
      "@tutrago/database": ["packages/database/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
